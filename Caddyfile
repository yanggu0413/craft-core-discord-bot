# ===================================================
# 網頁主儀表板 (Web Dashboard)
# 域名：dash.craft-core.xyz
# ===================================================
dash.craft-core.xyz {
    encode zstd gzip

    # 1. 所有 API 請求轉發至後端 API 服務 (Port 3000)
    handle /api/* {
        reverse_proxy localhost:3000
    }

    # 2. 將即時同步的 WebSocket 連線轉發至後end (Port 3000)
    handle /ws {
        reverse_proxy localhost:3000
    }

    # 3. 官方說明文檔 Vitepress 靜態網站
    handle /docs/* {
        root * /var/www/craft-core/docs
        file_server
        try_files {path} {path}/ /index.html
    }

    # 4. 其他所有請求（包含 React/Vite 路由）交給靜態檔案伺服器直接服務
    handle {
        root * /var/www/craft-core/dashboard
        file_server
        try_files {path} /index.html
    }
}

# ===================================================
# 容器託管平台 (Craft-Core Hosting Platform)
# 域名：hosting.craft-core.xyz
# ===================================================
hosting.craft-core.xyz {
    encode zstd gzip

    # 1. 轉發託管 API 請求至 Hosting 後端 (Port 3001)
    handle /api/* {
        reverse_proxy localhost:3001
    }

    # 2. 轉發 Hosting WebSocket 連線至 Backend (Port 3001)
    handle /ws {
        reverse_proxy localhost:3001
    }

    # 3. Hosting Web 前端靜態頁面託管
    handle {
        root * /var/www/craft-core/hosting
        file_server
        try_files {path} /index.html
    }
}
